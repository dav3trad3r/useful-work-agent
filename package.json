{
  "name": "useful-work-agent",
  "version": "0.1.0",
  "description": "Useful Work for agents and tool makers: agents pay for x402 tool calls by proofreading and checking public websites; tool makers offer those jobs and are paid for each one accepted.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "useful-work-agent": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tool-maker": {
      "types": "./dist/tool-maker.d.ts",
      "default": "./dist/tool-maker.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "x402",
    "agents",
    "ai-agents",
    "proofreading",
    "link-checker",
    "useful-work"
  ],
  "homepage": "https://usefulwork.app/builders",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dav3trad3r/useful-work-agent.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "jose": "^6.2.13",
    "node-html-parser": "^9.0.5",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@x402/core": "^2.29.0"
  },
  "peerDependenciesMeta": {
    "@x402/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.5",
    "@types/node": "^22.20.5",
    "@x402/core": "^2.29.0",
    "@x402/evm": "^2.29.0",
    "@x402/hono": "^2.29.0",
    "hono": "^4.13.14",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
